# Database (PostgreSQL / Supabase with asyncpg)
POSTGRES_CONNECTION_STRING=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# Storage Settings
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Cloudflare R2 Storage (Optional for production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Speech & AI Providers
SARVAM_API_KEY=
GEMINI_API_KEY=

# Server & Runtime Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=true
